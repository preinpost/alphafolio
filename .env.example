# AlphaFolio 환경변수 템플릿
#
# 로컬: 이 파일을 .env 로 복사해 채운다 (.env 는 gitignore)
# 배포: compose.yaml 의 environment 로 주입 (.env 를 이미지에 넣지 않는다)
#
# ⚠️ 모바일(Capacitor) 번들에는 어떤 시크릿도 들어가지 않는다.
#    앱이 아는 것은 AF_API_BASE_URL 뿐이고, 나머지는 전부 서버 전용이다.

# ── AlphaFolio 앱 설정 ─────────────────────────────────────────────
AF_PORT=8080
AF_HOST=0.0.0.0
AF_API_BASE_URL=http://localhost:8080

# 토큰 서명 키 (웹/모바일 공통 Bearer 토큰) — 반드시 고정할 것
AF_AUTH_SECRET=

# 계정 목록 — 여러 명이 한 서버를 공유한다
# 해시 생성: node apps/server/scripts/hash-password.mjs '비밀번호'
# AF_USERS=[{"name":"user1","passwordHash":"scrypt$..."}]
#
# 레거시(단일 사용자, 평문) — AF_USERS 가 없을 때만 쓰인다
AF_AUTH_USER=alpha
AF_AUTH_PASSWORD=

# 유휴 런타임 정리 기준(분)
AF_IDLE_MINUTES=60

# iOS 앱(Capacitor) 오리진 허용 목록 — 쉼표 구분. 비우면 capacitor://localhost
# AF_CORS_ORIGINS=capacitor://localhost

# 기본 모델 (pi 모델 ID — 프로바이더/모델)
AF_DEFAULT_MODEL=openrouter/deepseek/deepseek-v4.1-flash
AF_DEFAULT_THINKING=off

# ── 가계부 (Cloudflare D1) ─────────────────────────────────────────
# 대시보드 → Workers & Pages → D1 → 데이터베이스 생성
# API 토큰: My Profile → API Tokens → Create Token → D1 Edit 권한
AF_D1_ACCOUNT_ID=
AF_D1_DATABASE_ID=
AF_D1_TOKEN=

# ── 브로커 / 뉴스 키 (서버 기본값 — 설정 화면에서 사용자별로 덮어쓸 수 있다) ──
# ⚠️ 이름 변경 금지 — 기존 pi-* 패키지가 이 이름을 하드코딩으로 읽는다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
NCP_APIGW_API_KEY_ID=
NCP_APIGW_API_KEY=
# (Twelve Data·Finnhub·CoinGecko·Binance 는 쓰는 툴이 없어 뺐다)

# ── LLM 프로바이더 ─────────────────────────────────────────────────
# 로컬은 ~/.pi/agent/auth.json 의 OAuth/키를 그대로 쓰므로 비워둬도 된다.
# 사용자가 설정 화면에 자기 키를 넣으면 그 사람 대화에는 그 키가 우선한다.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# 컨테이너에서 호스트 pi OAuth 로그인을 재사용할 때 (auth.json 마운트 경로)
# AF_PI_AUTH_PATH=/secrets/auth.json
